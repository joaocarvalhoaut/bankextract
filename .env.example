VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SENTRY_DSN=

# Opcional enquanto a autenticacao nao estiver implementada no frontend.
VITE_SUPABASE_USER_ID=00000000-0000-0000-0000-000000000000
VITE_SUPABASE_COMPANY_ID=00000000-0000-0000-0000-000000000000

# Runtime backend / diagnostics
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp / Z-API
ENABLE_MOCK_WHATSAPP=true
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
TEST_ZAPI_INSTANCE_ID=
TEST_ZAPI_TOKEN=
TEST_ZAPI_CLIENT_TOKEN=

# Google Drive / OCR
ENABLE_GOOGLE_VISION_OCR=false
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# Optional diagnostics defaults
DIAGNOSTIC_COMPANY_ID=00000000-0000-0000-0000-000000000000
DIAGNOSTIC_DRY_RUN=true
ZAPI_DOCUMENT_MAX_BYTES=10485760
