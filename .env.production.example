VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Opcional: usado apenas como fallback/controlado no frontend
VITE_SYSTEM_ADMIN_EMAILS=admin@empresa.com,owner@empresa.com

# Opcionais apenas para fallback local/mock.
# Em producao conectada ao Supabase, prefira deixar vazios.
VITE_SUPABASE_COMPANY_ID=
VITE_SUPABASE_USER_ID=

# Backend / edge functions / diagnostics
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Producao segura: ativar false somente apos smoke test integrado
ENABLE_MOCK_WHATSAPP=false
ENABLE_GOOGLE_VISION_OCR=false

# Google Drive
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=

# Z-API principal e conta de teste controlada
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
TEST_ZAPI_INSTANCE_ID=
TEST_ZAPI_TOKEN=
TEST_ZAPI_CLIENT_TOKEN=

# Optional diagnostics defaults
DIAGNOSTIC_COMPANY_ID=
DIAGNOSTIC_DRY_RUN=true
ZAPI_DOCUMENT_MAX_BYTES=10485760
